# PetWeave example configuration (config v2: multiple pets).
# Copy to ~/.config/petweave/petweave.toml and adjust.
# All keys are optional — every section/field falls back to its default.
# The file is watched and hot-reloaded while running: pets can be added,
# removed, disabled or re-placed without restarting the host.

[general]
# Animation/render loop target FPS cap (1..=240).
fps = 60
# Log level: trace | debug | info | warn | error.
log_level = "info"
# How often to sample CPU/memory and notify pets (Event::System). 0 = off.
sysinfo_interval_secs = 5
# Register a StatusNotifierItem tray icon (left-click show/hide all; the menu
# lists every pet and its movement mode).
tray_enabled = true

[input]
# Master switch for global keyboard capture.
enabled = true
# Auto-detect keyboards under /dev/input/event*.
auto_detect = true
# Explicit device paths; wins over auto-detection for these devices.
# Find yours with: petweave list-devices
devices = []
# Hotplug rescan interval in seconds (fast 5s retry until a device is found).
scan_interval_secs = 30

# ---------------------------------------------------------------------------
# [render] = global defaults for every pet. Each [[pets]] entry inherits every
# key it does not set itself.
# ---------------------------------------------------------------------------
[render]
# Default surface size in pixels for pets that do not set their own.
# A pet's own size (bongo: cat_height, packages: pet.toml surface_width/
# surface_height) wins over this; an explicit [[pets]].width / height wins
# over everything and scales the artwork proportionally (never distorted).
width = 256
height = 256
# wlr-layer-shell layer: background | bottom | top | overlay.
# `overlay` keeps the pet above fullscreen windows; it is also switchable at
# runtime from the tray "渲染层级" menu (Top / Overlay).
layer = "top"
# Anchor: combination of top | bottom | left | right (| separated).
anchor = "bottom"
# Margins from the anchored edge(s). Negative values pin past the edge.
margin_top = 16
margin_right = 0
margin_bottom = 16
margin_left = 0
# Output to bind pets to, by name (xdg-output). Empty = auto.
# Find yours with: wlr-randr / hyprctl monitors / niri msg outputs
output = ""
# Never auto-hide for fullscreen windows.
disable_fullscreen_hide = false
# Click-through: only the pet's opaque shape receives clicks.
click_through = true
# Movement mode — also switchable at runtime from the tray "移动模式" menu:
#   drag    = the pet follows dragging and stays where it is dropped (default)
#   physics = drag + gravity/collision: the pet falls and settles
#   fixed   = the pet is pinned and cannot be moved
mode = "drag"

# ---------------------------------------------------------------------------
# [[pets]] — one block per pet instance (at most 12). `id` is optional and
# generated as "{kind}-{n}" when omitted; it is stable and used by the tray
# (and later by the settings panel).
# Every [render] key may be repeated here to override it for this pet only:
# width / height (user-facing size; `surface_width`/`surface_height` are the
# *package* spelling and are ignored here) / layer / anchor / margin_* / output /
# disable_fullscreen_hide / click_through / mode
# ---------------------------------------------------------------------------

# A BongoCat in the bottom-left corner.
[[pets]]
id = "bongo-main"
name = "BongoCat"
enabled = true
kind = "bongo"
anchor = "bottom|left"
margin_left = 32
margin_bottom = 24

# Kind-specific options live in [pets.bongo].
[pets.bongo]
assets_dir = "assets/bongocat"
cat_height = 110
keypress_duration_ms = 100
hand_mapping = true
mirror_x = false
# Sleep (dimmed cat) after this many seconds without a key press. 0 = off.
idle_sleep_timeout_secs = 0
# Scheduled sleep window (wall-clock); keys are ignored while active.
enable_scheduled_sleep = false
sleep_begin = "22:00"
sleep_end = "06:00"

# A second cat: different size, own placement, own movement mode. Uncomment to
# run two BongoCats side by side — they share their decoded PNGs, so the extra
# instance costs one render frame rather than another set of assets.
# [[pets]]
# id = "bongo-small"
# name = "小号 BongoCat"
# enabled = true
# kind = "bongo"
# anchor = "bottom|right"
# margin_right = 32
# margin_bottom = 24
# mode = "physics"   # opt into gravity for this pet only
#
# [pets.bongo]
# cat_height = 70

# A declarative sprite pet from an installed role package
# (`petweave list` shows installed packages).
# [[pets]]
# id = "blinky"
# name = "Blinky"
# enabled = true
# kind = "sprite"
# package = "blinky"
# anchor = "top|right"
# margin_top = 40
# margin_right = 40

# A Lua-scripted pet with a speech bubble.
# [[pets]]
# id = "lua-demo"
# name = "Lua 气泡"
# enabled = true
# kind = "lua"
# package = "lua-demo"
# anchor = "top|left"
# margin_top = 40
# margin_left = 40
# click_through = false

# Built-in demo pet (colored square, no package needed). `color` is the
# demo-only option; it flashes white on keypress.
# [[pets]]
# id = "demo-1"
# name = "Demo"
# kind = "demo"
# color = "#ff6699"
# mode = "fixed"

# ---------------------------------------------------------------------------
# Legacy single-pet configs keep working: a file with only [pet]/[pet.bongo]
# (and no [[pets]]) is read as one pet with id "default".
# Convert it in place (comments preserved, .bak backup) with:
#     petweave config migrate --write
# ---------------------------------------------------------------------------
# [pet]
# name = "bongo"
# kind = "bongo"
#
# [pet.bongo]
# cat_height = 110
